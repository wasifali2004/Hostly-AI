# Server
NODE_ENV=development
PORT=4100
FRONTEND_URL=http://localhost:3100
API_URL=http://localhost:4100


# JWT - replace with independent long, random values (at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Hosted PostgreSQL (Supabase)
# DATABASE_URL should use the pooled runtime endpoint.
# DIRECT_URL should use the direct endpoint for Prisma migrations.
DATABASE_URL=
DIRECT_URL=
SUPABASE_PASSWORD=

# Upstash Redis REST credentials power public-page caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional native Redis connection for BullMQ. Use the rediss:// connection
# string from Upstash, not the HTTPS REST URL. Leave blank to use Hostly's
# durable PostgreSQL reminder scheduler.
REDIS_URL=

# Transactional email (optional in development)
RESEND_API_KEY=
EMAIL_FROM=Hostly AI <onboarding@resend.dev>

# Supabase Storage (optional; upload endpoint falls back to local ./uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=event-images

# Gemini AI
GEMINI_API_KEY=
# Optional stable model override.
GEMINI_MODEL=gemini-2.5-flash
