generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrgRole {
  ORG_ADMIN
  ORGANIZER
  ATTENDEE

  @@map("org_role")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("event_status")
}

enum LocationType {
  PHYSICAL
  VIRTUAL
  HYBRID

  @@map("location_type")
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
  CHECKED_IN

  @@map("registration_status")
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED

  @@map("reminder_status")
}

enum RoomAvailabilityType {
  HOURLY
  PER_EVENT

  @@map("room_availability_type")
}

enum AuditAction {
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_DELETED
  VENUE_CREATED
  VENUE_UPDATED
  VENUE_DELETED
  ROOM_CREATED
  ROOM_UPDATED
  ROOM_DELETED
  MEMBER_ROLE_CHANGED
  REGISTRATION_CHECKED_IN

  @@map("audit_action")
}

enum DataDeletionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED

  @@map("data_deletion_status")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique(map: "uq_users_email") @db.VarChar(320)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  name            String    @db.VarChar(120)
  avatarUrl       String?   @map("avatar_url") @db.Text
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens       RefreshToken[]
  createdOrganizations Organization[] @relation("OrganizationCreator")
  memberships         Membership[]
  sentInvitations     Invitation[]   @relation("InvitationInviter")
  acceptedInvitations Invitation[]   @relation("InvitationAcceptor")
  organizedEvents     Event[]        @relation("EventOrganizer")
  registrations       Registration[] @relation("RegistrationUser")
  legacyCheckIns      Registration[] @relation("RegistrationCheckedInBy")
  performedCheckIns   CheckIn[]      @relation("CheckInStaff")
  auditLogs           AuditLog[]     @relation("AuditActor")
  deletionRequests    DataDeletionRequest[] @relation("DeletionRequester")
  processedDeletionRequests DataDeletionRequest[] @relation("DeletionProcessor")

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash") @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @unique(map: "uq_refresh_tokens_replaced_by") @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "refresh_tokens_user_id_fkey")
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull, map: "refresh_tokens_replaced_by_token_id_fkey")
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId, expiresAt], map: "idx_refresh_tokens_user_expires")
  @@map("refresh_tokens")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique(map: "uq_organizations_slug") @db.VarChar(120)
  description String?  @db.Text
  logoUrl     String?  @map("logo_url") @db.Text
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User          @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: Restrict, map: "organizations_created_by_id_fkey")
  memberships  Membership[]
  invitations  Invitation[]
  events       Event[]
  ticketTiers  TicketTier[]
  registrations Registration[]
  checkIns      CheckIn[]
  reminderJobs ReminderJob[]
  venues       Venue[]
  rooms        Room[]
  auditLogs    AuditLog[]
  deletionRequests DataDeletionRequest[]

  @@index([createdById], map: "idx_organizations_created_by")
  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           OrgRole  @default(ATTENDEE)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "memberships_organization_id_fkey")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "memberships_user_id_fkey")

  @@unique([organizationId, userId], map: "uq_memberships_organization_user")
  @@index([organizationId, role], map: "idx_memberships_organization_role")
  @@index([userId], map: "idx_memberships_user")
  @@map("memberships")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.VarChar(320)
  role           OrgRole
  tokenHash      String           @unique(map: "uq_invitations_token_hash") @map("token_hash") @db.VarChar(255)
  status         InvitationStatus @default(PENDING)
  invitedById    String           @map("invited_by_id") @db.Uuid
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "invitations_organization_id_fkey")
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict, map: "invitations_invited_by_id_fkey")
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull, map: "invitations_accepted_by_id_fkey")

  @@index([organizationId, status], map: "idx_invitations_organization_status")
  @@index([email, status], map: "idx_invitations_email_status")
  @@index([expiresAt], map: "idx_invitations_expires")
  @@map("invitations")
}

model Event {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organizerId    String       @map("organizer_id") @db.Uuid
  venueId        String?      @map("venue_id") @db.Uuid
  roomId         String?      @map("room_id") @db.Uuid
  title          String       @db.VarChar(180)
  slug           String       @unique(map: "uq_events_slug") @db.VarChar(180)
  description    String       @db.Text
  status         EventStatus  @default(DRAFT)
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime     @map("ends_at") @db.Timestamptz(3)
  timezone       String       @default("UTC") @db.VarChar(80)
  locationType   LocationType @map("location_type")
  venueName      String?      @map("venue_name") @db.VarChar(180)
  addressLine1   String?      @map("address_line_1") @db.VarChar(500)
  addressLine2   String?      @map("address_line_2") @db.VarChar(500)
  city           String?      @db.VarChar(120)
  region         String?      @db.VarChar(120)
  postalCode     String?      @map("postal_code") @db.VarChar(32)
  country        String?      @db.VarChar(2)
  virtualUrl     String?      @map("virtual_url") @db.Text
  capacity       Int?
  coverImageUrl  String?      @map("cover_image_url") @db.Text
  category       String       @db.VarChar(80)
  tags           String[]     @default([])
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)
  searchVector   Unsupported("tsvector")? @map("search_vector")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "events_organization_id_fkey")
  organizer    User           @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict, map: "events_organizer_id_fkey")
  venue        Venue?         @relation(fields: [venueId, organizationId], references: [id, organizationId], onDelete: NoAction, map: "events_venue_tenant_fkey")
  room         Room?          @relation(fields: [roomId, venueId, organizationId], references: [id, venueId, organizationId], onDelete: NoAction, map: "events_room_tenant_fkey")
  ticketTiers  TicketTier[]
  registrations Registration[]
  checkIns      CheckIn[]

  @@unique([organizationId, slug], map: "uq_events_organization_slug")
  @@unique([id, organizationId], map: "uq_events_id_organization")
  @@index([organizationId, status, startsAt], map: "idx_events_organization_status_starts")
  @@index([organizerId, status], map: "idx_events_organizer_status")
  @@index([status, startsAt], map: "idx_events_status_starts")
  @@index([category], map: "idx_events_category")
  @@index([city], map: "idx_events_city")
  @@index([organizationId, roomId, startsAt, endsAt], map: "idx_events_room_schedule")
  @@map("events")
}

model Venue {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(180)
  address        String    @db.VarChar(500)
  capacity       Int
  description    String?   @db.Text
  imageUrl       String?   @map("image_url") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "venues_organization_id_fkey")
  rooms        Room[]
  events       Event[]

  @@unique([id, organizationId], map: "uq_venues_id_organization")
  @@index([organizationId, deletedAt, name], map: "idx_venues_organization_active")
  @@map("venues")
}

model Room {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  venueId          String               @map("venue_id") @db.Uuid
  name             String               @db.VarChar(180)
  capacity         Int
  floor            String?              @db.VarChar(80)
  equipment        String[]             @default([])
  availabilityType RoomAvailabilityType @default(PER_EVENT) @map("availability_type")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "rooms_organization_id_fkey")
  venue        Venue        @relation(fields: [venueId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "rooms_venue_tenant_fkey")
  events       Event[]

  @@unique([id, venueId, organizationId], map: "uq_rooms_id_venue_organization")
  @@index([organizationId, venueId, deletedAt, name], map: "idx_rooms_venue_active")
  @@map("rooms")
}

model TicketTier {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  name           String    @db.VarChar(100)
  description    String?   @db.Text
  capacity       Int
  priceCents     Int       @default(0) @map("price_cents")
  currency       String    @default("USD") @db.Char(3)
  salesStartAt   DateTime? @map("sales_start_at") @db.Timestamptz(3)
  salesEndAt     DateTime? @map("sales_end_at") @db.Timestamptz(3)
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "ticket_tiers_organization_id_fkey")
  event        Event          @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "ticket_tiers_event_tenant_fkey")
  registrations Registration[]

  @@unique([organizationId, eventId, name], map: "uq_ticket_tiers_organization_event_name")
  @@unique([id, eventId, organizationId], map: "uq_ticket_tiers_id_event_organization")
  @@index([organizationId, eventId, isActive], map: "idx_ticket_tiers_organization_event_active")
  @@map("ticket_tiers")
}

model Registration {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  eventId        String             @map("event_id") @db.Uuid
  ticketTierId   String             @map("ticket_tier_id") @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  attendeeName   String             @map("attendee_name") @db.VarChar(120)
  attendeeEmail  String             @map("attendee_email") @db.VarChar(320)
  attendeePhone  String?            @map("attendee_phone") @db.VarChar(40)
  status         RegistrationStatus @default(CONFIRMED)
  qrCode         String             @unique(map: "uq_registrations_qr_code") @map("qr_code") @db.VarChar(128)
  checkedInAt    DateTime?          @map("checked_in_at") @db.Timestamptz(3)
  checkedInById  String?            @map("checked_in_by_id") @db.Uuid
  cancelledAt    DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "registrations_organization_id_fkey")
  event        Event        @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "registrations_event_tenant_fkey")
  ticketTier   TicketTier   @relation(fields: [ticketTierId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict, map: "registrations_ticket_tier_tenant_fkey")
  user         User?        @relation("RegistrationUser", fields: [userId], references: [id], onDelete: SetNull, map: "registrations_user_id_fkey")
  checkedInBy  User?        @relation("RegistrationCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull, map: "registrations_checked_in_by_id_fkey")
  checkIn      CheckIn?
  reminderJob  ReminderJob?

  @@unique([eventId, attendeeEmail], map: "uq_registrations_event_attendee_email")
  @@unique([id, organizationId], map: "uq_registrations_id_organization")
  @@unique([id, eventId, organizationId], map: "uq_registrations_id_event_organization")
  @@index([organizationId, eventId, status], map: "idx_registrations_organization_event_status")
  @@index([organizationId, eventId, ticketTierId, status], map: "idx_registrations_event_tier_status")
  @@index([userId, createdAt], map: "idx_registrations_user_created")
  @@index([checkedInAt], map: "idx_registrations_checked_in")
  @@map("registrations")
}

model CheckIn {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  registrationId String   @unique(map: "uq_check_ins_registration") @map("registration_id") @db.Uuid
  checkedInById  String?  @map("checked_in_by_id") @db.Uuid
  checkedInAt    DateTime @default(now()) @map("checked_in_at") @db.Timestamptz(3)
  method         String   @default("QR") @db.VarChar(24)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "check_ins_organization_id_fkey")
  event        Event        @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "check_ins_event_tenant_fkey")
  registration Registration @relation(fields: [registrationId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade, map: "check_ins_registration_tenant_fkey")
  checkedInBy  User?        @relation("CheckInStaff", fields: [checkedInById], references: [id], onDelete: SetNull, map: "check_ins_checked_in_by_id_fkey")

  @@unique([registrationId, eventId, organizationId], map: "uq_check_ins_registration_tenant")
  @@index([organizationId, eventId, checkedInAt], map: "idx_check_ins_organization_event_time")
  @@index([checkedInById], map: "idx_check_ins_checked_in_by")
  @@map("check_ins")
}

model ReminderJob {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  registrationId    String         @unique(map: "uq_reminder_jobs_registration") @map("registration_id") @db.Uuid
  queueJobId        String?        @unique(map: "uq_reminder_jobs_queue_job") @map("queue_job_id") @db.VarChar(128)
  scheduledFor      DateTime       @map("scheduled_for") @db.Timestamptz(3)
  status            ReminderStatus @default(PENDING)
  providerMessageId String?        @map("provider_message_id") @db.VarChar(255)
  attempts          Int            @default(0)
  lastError         String?        @map("last_error") @db.Text
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "reminder_jobs_organization_id_fkey")
  registration Registration @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "reminder_jobs_registration_tenant_fkey")

  @@unique([registrationId, organizationId], map: "uq_reminder_jobs_registration_tenant")
  @@index([status, scheduledFor], map: "idx_reminder_jobs_status_scheduled")
  @@index([organizationId], map: "idx_reminder_jobs_organization")
  @@map("reminder_jobs")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  actorId        String?     @map("actor_id") @db.Uuid
  action         AuditAction
  entityType     String      @map("entity_type") @db.VarChar(80)
  entityId       String?     @map("entity_id") @db.Uuid
  entityLabel    String?     @map("entity_label") @db.VarChar(240)
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "audit_logs_organization_id_fkey")
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, map: "audit_logs_actor_id_fkey")

  @@index([organizationId, createdAt], map: "idx_audit_logs_organization_time")
  @@index([organizationId, action, createdAt], map: "idx_audit_logs_organization_action")
  @@index([actorId], map: "idx_audit_logs_actor")
  @@map("audit_logs")
}

model DataDeletionRequest {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  requesterId    String             @map("requester_id") @db.Uuid
  requesterEmail String             @map("requester_email") @db.VarChar(320)
  status         DataDeletionStatus @default(PENDING)
  reason         String?            @db.Text
  adminNote      String?            @map("admin_note") @db.Text
  processedById  String?            @map("processed_by_id") @db.Uuid
  processedAt    DateTime?          @map("processed_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "data_deletion_requests_organization_id_fkey")
  requester    User         @relation("DeletionRequester", fields: [requesterId], references: [id], onDelete: Cascade, map: "data_deletion_requests_requester_id_fkey")
  processedBy  User?        @relation("DeletionProcessor", fields: [processedById], references: [id], onDelete: SetNull, map: "data_deletion_requests_processed_by_id_fkey")

  @@index([organizationId, status, createdAt], map: "idx_deletion_requests_organization_status")
  @@index([requesterId, createdAt], map: "idx_deletion_requests_requester")
  @@map("data_deletion_requests")
}
